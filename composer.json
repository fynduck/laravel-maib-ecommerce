{
    "name": "fynduck/laravel-maib-ecommerce",
    "description": "Laravel package for the maib (Moldova Agroindbank) e-Commerce payment gateway.",
    "keywords": ["laravel", "maib", "maibmerchants", "payment", "ecommerce", "moldova"],
    "homepage": "https://github.com/fynduck/laravel-maib-ecommerce",
    "license": "MIT",
    "authors": [
        {
            "name": "Fynduck"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Fynduck\\MaibEcommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fynduck\\MaibEcommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fynduck\\MaibEcommerce\\MaibServiceProvider"
            ],
            "aliases": {
                "Maib": "Fynduck\\MaibEcommerce\\Facades\\Maib"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
